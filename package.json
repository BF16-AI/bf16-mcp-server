    "deepseek",
    "glm",
    "kimi"
  ],
  "homepage": "https://bf16.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BF16-AI/bf16-mcp-server.git"
  },
  "author": "BF16 Team <hello@bf16.ai> (https://bf16.ai)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
